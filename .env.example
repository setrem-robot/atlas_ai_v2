# =============================================================================
# RobotEye - configuracao de ambiente
#
# Nao e preciso editar isto a mao: `roboteye setup` faz as tres perguntas que
# importam (onde roda a IA, qual modelo, qual voz), testa o endereco antes de
# gravar e escreve as respostas aqui sem apagar estes comentarios. A pagina do
# celular (`roboteye web`) faz o mesmo depois de instalado.
#
# Copie para `.env` e ajuste. Todas as chaves usam o prefixo ROBOTEYE_.
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Backend: "ollama" (padrao) ou "echo" (repete o texto, util sem LLM instalado)
ROBOTEYE_LLM_BACKEND=ollama
ROBOTEYE_OLLAMA_HOST=http://localhost:11434
ROBOTEYE_LLM_MODEL=llama3.2:1b
ROBOTEYE_LLM_TIMEOUT=60
# IA de reserva, no proprio robo, para quando a de cima nao responder — e o que
# faz o robo continuar conversando quando o WiFi cai no meio de uma
# apresentacao. Vazio desliga a reserva. O modelo aqui costuma ser menor que o
# de cima: quem responde e o Pi. Ver `llm/fallback.py`.
ROBOTEYE_LLM_FALLBACK_HOST=
ROBOTEYE_LLM_FALLBACK_MODEL=
# De quantos em quantos segundos perguntar, em segundo plano, se a IA de cima
# voltou. 0 desliga a vigia (a volta so e percebida no proximo arranque).
ROBOTEYE_LLM_PROBE_INTERVAL=10
# Quantas mensagens (usuario + assistente) manter no historico
ROBOTEYE_LLM_HISTORY=8
# Idioma da resposta. Deixe vazio para acompanhar o idioma da voz escolhida
# (voz brasileira -> responde em portugues). Preencha para forcar um idioma.
ROBOTEYE_REPLY_LANGUAGE=
# Teto de tokens por resposta (o robo fala, nao redige)
ROBOTEYE_LLM_MAX_TOKENS=120

# --- Personalidade -----------------------------------------------------------
# Personagem: le persona/<nome>.md e persona/<nome>.memoria.md
ROBOTEYE_PERSONA=atlas
ROBOTEYE_PERSONA_DIR=persona

# --- Voz (TTS) ---------------------------------------------------------------
# Motor: "auto" (deixa a voz decidir — recomendado), "piper", "kokoro",
# "edge" (online) ou "null" (mudo)
ROBOTEYE_TTS_BACKEND=auto

# Voz do catalogo. Trocar esta linha e a forma normal de trocar de voz.
#   Motor piper  — leve e rapidissimo, bom ate num Raspberry Pi:
#     dii     Dii              feminina, portugues do Brasil
#     faber   Faber            masculina, portugues do Brasil
#     lessac  Lessac           feminina, ingles
#   Motor kokoro — 24 kHz, qualidade superior, pesa mais na CPU:
#     dora    Dora             feminina, pt-BR  <- melhor voz feminina offline
#     alex    Alex             masculina, portugues do Brasil
#     heart   Heart            feminina, ingles
#   Motor edge   — as mais naturais em pt-BR, mas precisam de internet:
#     thalita   Thalita        feminina, pt-BR  <- a mais natural de todas
#     francisca Francisca      feminina, pt-BR
# Veja a lista com `roboteye voice list` e baixe com `roboteye voice download <nome>`.
# O idioma da resposta acompanha a voz, a menos que ROBOTEYE_REPLY_LANGUAGE diga outra coisa.
ROBOTEYE_VOICE=francisca

# Reserva offline de uma voz online, para que ficar sem internet troque o timbre
# em vez de calar o robo. Aceita:
#   auto  escolhe pelo idioma e pela maquina (num Raspberry Pi cai numa voz
#         leve: cair numa pesada trocaria "sem internet" por "fala arrastada")
#   off   desliga
#   <voz> fixa uma voz do catalogo, quando o palpite de hardware nao serve
ROBOTEYE_VOICE_FALLBACK=auto

# Voz especifica dentro do pacote Kokoro (so para motor kokoro; vazio = a do catalogo)
ROBOTEYE_VOICE_SPEAKER=

# Apenas para modelos fora do catalogo. Se preenchido, tem prioridade sobre
# ROBOTEYE_VOICE — e ai convem definir ROBOTEYE_REPLY_LANGUAGE tambem.
ROBOTEYE_VOICE_MODEL=
ROBOTEYE_VOICE_CONFIG=
# Velocidade da fala: <1.0 mais rapido, >1.0 mais lento
ROBOTEYE_VOICE_LENGTH_SCALE=1.0
# Volume. As vozes nao saem no mesmo nivel — medindo a mesma frase, a `dii` sai
# com mais que o dobro da energia da `thalita` — entao trocar de voz muda o
# volume. Este e o ajuste para compensar; nao ha risco de estourar, o audio
# passa por um limitador antes de ir para a placa.
ROBOTEYE_VOICE_GAIN=1.0
ROBOTEYE_VOICE_NOISE_SCALE=0.667
ROBOTEYE_VOICE_NOISE_W=0.8
# Dispositivo de saida do sounddevice (vazio = padrao do sistema)
# Placa de som. "auto" (padrao) procura uma caixinha USB e so cai para a saida
# do sistema se nao houver nenhuma — e o que faz o robo acertar sozinho, ja que
# no Raspberry Pi o padrao e o HDMI, que depende de a tela ter alto-falante.
# Tambem aceita o indice do dispositivo (0, 1, 2...) ou parte do nome dele.
# Vazio deixa a escolha inteiramente com o sistema.
ROBOTEYE_AUDIO_DEVICE=auto

# --- Escuta (microfone) ------------------------------------------------------
# Desligada por padrao: um microfone aberto e uma decisao de quem monta o robo.
# Precisa do modelo baixado antes -- veja ./scripts/baixar-modelo-escuta.sh
ROBOTEYE_HEARING_ENABLED=false
# "whisper" (entende muito melhor, e o padrao), "vosk" (mais leve) ou "null"
ROBOTEYE_HEARING_BACKEND=whisper
# Tamanho do modelo Whisper: "tiny" (mais rapido) ou "base" (entende melhor).
# Medidos num Pi 5: 0,35x e 0,59x do tempo real.
ROBOTEYE_HEARING_MODEL_SIZE=base
ROBOTEYE_HEARING_MODEL_DIR=models/escuta
# Nucleos para transcrever. Um fica de fora para a face nao engasgar.
ROBOTEYE_HEARING_THREADS=3
# Microfone: "auto" procura uma placa USB; tambem aceita indice ou parte do nome
ROBOTEYE_HEARING_DEVICE=auto
# Nome que acorda o robo. "Atlas, quantos alunos tem o curso?" e uma pergunta;
# a mesma frase sem o nome e alguem conversando perto dele. Vazio responde a
# tudo que ouvir -- util para testar, ruim numa sala com gente.
ROBOTEYE_WAKE_WORD=atlas

# --- Face --------------------------------------------------------------------
ROBOTEYE_FACE_ENABLED=true
ROBOTEYE_FACE_FULLSCREEN=false
ROBOTEYE_FACE_WIDTH=1280
ROBOTEYE_FACE_HEIGHT=720
# Quadros por segundo. Vazio usa o padrao da maquina: 30 em ARM (Raspberry Pi),
# onde cada quadro e gasto continuo de CPU, e 60 no resto.
ROBOTEYE_FACE_FPS=
# Cor dos olhos em hexadecimal
ROBOTEYE_EYE_COLOR=#04C9FD
ROBOTEYE_BACKGROUND_COLOR=#000000
# Trocar de expressao sozinha quando ociosa
ROBOTEYE_IDLE_ANIMATIONS=true
# Arredondamento dos cantos, como fracao do menor lado do olho:
# 0.5 = circulo, 0.30 = quadrado de cantos macios (padrao), 0.10 = quase reto
ROBOTEYE_EYE_CORNER_RADIUS=0.30
# Quanto gastar por quadro: "auto" (baixo em Raspberry Pi, medio no resto),
# "low", "medium" ou "high". O antialiasing das bordas nao depende disto — e
# analitico e sai igual nos tres niveis. O que muda e o halo, o degrade e o teto
# de resolucao do desenho.
ROBOTEYE_FACE_QUALITY=auto

# --- Pagina de configuracao --------------------------------------------------
# O robo serve uma pagina para ser aberta do celular, onde da para trocar a voz,
# apontar para outra maquina de IA e testar a conexao sem precisar de SSH.
ROBOTEYE_WEB_ENABLED=true
# 0.0.0.0 deixa a pagina acessivel pela rede, que e o objetivo. Ponha 127.0.0.1
# para fechar tudo menos o proprio robo.
ROBOTEYE_WEB_HOST=0.0.0.0
ROBOTEYE_WEB_PORT=8080
# PIN de acesso. Vazio faz o robo sortear um a cada arranque e mostra-lo no log;
# numa instalacao de verdade convem fixar um aqui.
ROBOTEYE_WEB_PIN=

# --- Diversos ----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
ROBOTEYE_LOG_LEVEL=INFO
